# Copy to .env and adjust. Only PLANT_ID_* names are read by plant-id (Option A for cloud keys).

# Local Ollama (backend vlm — default for plant-id identify/demo)
# PLANT_ID_OLLAMA_HOST=http://127.0.0.1:11434
# PLANT_ID_VISION_MODEL=qwen3-vl:2b

# Cloud VLM (backend vlm-cloud — default for eval.run_oxford102)
# Export your vendor key into the canonical name, e.g.:
# export PLANT_ID_VLM_CLOUD_API_KEY="$FIREWORKS_API_KEY"
# PLANT_ID_VLM_CLOUD_BASE_URL=https://api.fireworks.ai/inference/v1
# PLANT_ID_VLM_CLOUD_MODEL=accounts/fireworks/models/qwen3-vl-8b-instruct
# PLANT_ID_VLM_CLOUD_VENDOR=fireworks
# PLANT_ID_VLM_CLOUD_REASONING_EFFORT=none  # none | low | medium | high | max; omit param if unset empty
# PLANT_ID_IDENTIFY_ARTIFACTS_DIR=identify_artifacts
# PLANT_ID_EVAL_RUNS_DIR=eval_runs
# PLANT_ID_INVALID_LABEL_RETRY_ENABLED=true  # retry once when species_label is not in catalog

# Optional local Opik tracing
# PLANT_ID_OPIK_ENABLED=true
